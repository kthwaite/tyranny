  "signal": {
    "description": "stereo int16; sum of three chirps over 2.0 s: log 40->2000 Hz, log 3000->250 Hz, lin 700->1300 Hz; sample n at rate r is evaluated at t=n/r; channel c = sum_i amplitudes[i]*sin(phase_i(t)+phases[c][i]); quantised round(x*32768)",
    "amplitudes": [
      0.25,
      0.2,
      0.15
    ],
    "phases": [
      [
        0.0,
        0.0,
        0.0
      ],
      [
        1.5707963267948966,
        4.141592653589793,
        2.0707963267948966
      ]
    ]
  },
